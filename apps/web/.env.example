NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Browser-safe Supabase project settings. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Used only when Supabase browser settings are absent in local development.
NEXT_PUBLIC_LOCAL_USER_ID=local-user
NEXT_PUBLIC_GITHUB_URL=https://github.com/Anas-github-acc/PayGuardian

# LLM Providers for About PayGuardian Explainer
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.8-flash
APINEX_API_KEY=your-apinex-api-key
DEFAULT_MODEL=free/gpt-6-luna
