NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Browser-safe Supabase project settings. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Used only when Supabase browser settings are absent in local development.
NEXT_PUBLIC_LOCAL_USER_ID=local-user
