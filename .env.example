# Shared non-secret defaults. Keep actual values in local/platform secret stores.
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_PORT=3001
AGENT_RUNTIME_URL=http://localhost:8000
AGENT_RUNTIME_SHARED_SECRET=replace-with-a-local-only-value
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=replace-with-a-local-only-value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-a-local-only-value
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-only-value
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-sandbox-client-secret
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel
PAYPAL_WEBHOOK_ID=replace-with-paypal-sandbox-webhook-id
PAYPAL_EXECUTION_MODE=inline
ENABLE_LOCAL_DEV_AUTH=true
DATABASE_MODE=memory
